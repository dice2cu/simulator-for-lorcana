{
  "name": "simulator-for-lorcana-web",
  "version": "0.0.1",
  "description": "A static web page for building decks, simulating matchups and playing games with the Lorcana simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node build.mjs",
    "dev": "node build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "(MIT OR Unlicense)",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
